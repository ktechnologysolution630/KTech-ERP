# Database connection URL
# Local PGlite on disk (default): pglite:./.pglite
# In-memory PGlite: pglite:memory
# Production Postgres (Neon): postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=pglite:./.pglite

# JWT Session Secret (min 32 chars in production)
SESSION_SECRET=dev-secret-change-me-in-production-00000000

# Optional: Vercel Blob storage token (falls back to ./.uploads locally)
# BLOB_READ_WRITE_TOKEN=
