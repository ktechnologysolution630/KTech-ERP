# Database (Neon / Postgres in production; leave empty in local dev to use local PGlite in .pglite)
DATABASE_URL=

# Session signing secret (at least 32 characters)
AUTH_SECRET=replace-with-at-least-32-character-secret-key

# Vercel Blob token (optional in local dev; falls back to .uploads)
BLOB_READ_WRITE_TOKEN=

# Initial admin seed credentials
SEED_ADMIN_EMAIL=admin@ktec.local
SEED_ADMIN_PASSWORD=ChangeMe123!
